# Copy to .env for local development (never commit real values).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/comproof
COOKIE_SECURE=false
PLATFORM_ADMIN_EMAIL=you@example.com
PLATFORM_ADMIN_PASSWORD=Change#Me2026
PLATFORM_ADMIN_NAME=Comp11 Labs

# Where uploaded files and comparison results are kept (a Railway volume in production).
DATA_DIR=./data
MAX_UPLOAD_MB=60
ENGINE_WORKERS=1          # comparisons run at the same time on this server
RUN_WORKER=true           # false on a web-only replica

# AI providers (optional). Only providers with a key appear in Settings > Engine.
# Keys are read from the environment only; they are never stored in the database.
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_VISION_MODEL=qwen-vl-plus
# QWEN_TEXT_MODEL=qwen-plus
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# CUSTOM_AI_LABEL=Company gateway
# CUSTOM_AI_BASE_URL=https://ai.example.com/v1
# CUSTOM_AI_API_KEY=
# CUSTOM_AI_VISION_MODEL=
# CUSTOM_AI_TEXT_MODEL=
